{
  "schema": "experimental_brittle_chip_v1",
  "provenance": "Local prefragmented rigid-body experiment, following MuJoCo issue #577. All dimensions, density, strengths and solver settings below are illustrative, not measurements of a real potato chip.",
  "method_source": "https://github.com/google-deepmind/mujoco/issues/577",
  "diameters_m": [0.07, 0.05],
  "thickness_m": 0.001,
  "saddle_height_m": 0.003,
  "density_kg_m3": 450.0,
  "sectors": 8,
  "inner_radius_fraction": 0.48,
  "bond_force_limit_n": 0.3,
  "bond_moment_limit_nm": 0.0005,
  "failure_rule": "max(norm(force)/force_limit, norm(moment_at_shared_edge)/moment_limit) >= 1",
  "timestep_s": 0.001,
  "constraint_time_constant_s": 0.003,
  "weld_torquescale_m": 1.0,
  "weld_solimp": [0.9999, 0.9999, 0.0001, 0.5, 2.0],
  "internal_collision_rule": "No internal-face collision within a connected weld cluster; all separated clusters and all external objects collide",
  "chip_center_height_m": 0.031,
  "support_half_span_m": 0.022,
  "support_radius_m": 0.002,
  "support_axis_height_m": 0.024,
  "probe_home_height_m": 0.050,
  "probe_radius_m": 0.005,
  "probe_mass_kg": 0.01,
  "probe_servo_kp_n_m": 300.0,
  "probe_servo_kv_ns_m": 1.0,
  "probe_speed_m_s": 0.008,
  "demo_travel_m": 0.030,
  "friction": [0.5, 0.001, 0.00001]
}
